#!/bin/sh
set -e

# 升级或重装后确保辅助程序仍带 setuid 位。
#
# 包内本身已经是 4755 root:root（见 debian/rules 的 override_dh_fixperms），
# 这里只做兜底：某些打包/安装路径（strip、手动 rsync、非 fakeroot 构建）
# 会把 setuid 位丢掉，而丢了之后首次开启 TUN 会退回到 pkexec 授权流程。
# 辅助程序名由 CMake 派生（<app>-tun），这里按后缀匹配，改软件名后仍然有效
for helper in /usr/bin/*-tun; do
    [ -f "$helper" ] || continue
    chown root:root "$helper"
    chmod 4755 "$helper"
done

#DEBHELPER#

exit 0
